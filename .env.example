# Copy to .env:  cp .env.example .env
# This file is gitignored -- the server's configuration stays out of the repo.


# --- Image version --------------------------------------------------------
# latest    = whatever is currently on main
# sha-xxxxx = a specific commit, e.g. for a rollback
# deploy.sh uses its own value and overrides this variable during a deploy,
# so you do not need to keep it up to date by hand.
IMAGE_TAG=latest


# --- OpenWebRX ------------------------------------------------------------
# When OpenWebRX runs on this same host:
# OPENWEBRX_WS_URL=ws://host.docker.internal:8073/ws/
OPENWEBRX_WS_URL=ws://192.168.68.67:8073/ws/
FREQUENCIES=149287500:nfm


# --- Squelch (open threshold above the noise floor) -----------------------
SQUELCH_MARGIN=10
RMS_MARGIN=20
NOISE_WINDOW_SECONDS=600


# --- Recording ------------------------------------------------------------
PRE_ROLL_SECONDS=2
END_SILENCE_SECONDS=3
MIN_DURATION_SECONDS=1
MAX_RECORDING_SECONDS=600
MP3_BITRATE=32
OUTPUT_RATE=12000


# --- Transcriber ----------------------------------------------------------
MIN_AGE_SECONDS=300
LANGUAGE=pl
MAX_FILE_MB=20
# The J1800 has 4 logical cores, but the OS uses them too. 4 does work, yet it
# can starve everything else -- 3 is the safe compromise.
THREADS=3


# --- Web ------------------------------------------------------------------
# Host port. Inside the container it is always 8074.
WEB_PORT=8074


# --- Paths and time zone --------------------------------------------------
# Host directory for recordings (relative to the directory holding
# docker-compose.yml).
RECORDINGS_DIR=./recordings
TZ=Europe/Warsaw

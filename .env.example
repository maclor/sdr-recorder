# Skopiuj na .env:  cp .env.example .env
# Ten plik jest ignorowany przez gita — konfiguracja serwera nie jest w repo.


# --- Wersja obrazów -------------------------------------------------------
# latest    = to, co jest aktualnie na main
# sha-xxxxx = konkretny commit, np. do rollbacku
# deploy.sh używa własnej wartości i nadpisuje tę zmienną w trakcie wdrożenia,
# więc tutaj wartości nie musisz aktualizować ręcznie.
IMAGE_TAG=latest


# --- OpenWebRX ------------------------------------------------------------
# Gdy OpenWebRX jest na tym samym hoście:
# OPENWEBRX_WS_URL=ws://host.docker.internal:8073/ws/
OPENWEBRX_WS_URL=ws://192.168.68.67:8073/ws/
FREQUENCIES=149287500:nfm


# --- Bramkowanie (próg otwarcia ponad poziomem szumu) --------------------
SQUELCH_MARGIN=10
RMS_MARGIN=20
NOISE_WINDOW_SECONDS=600


# --- Nagrania -------------------------------------------------------------
PRE_ROLL_SECONDS=2
END_SILENCE_SECONDS=3
MIN_DURATION_SECONDS=1
MAX_RECORDING_SECONDS=600
MP3_BITRATE=32
OUTPUT_RATE=12000


# --- Transkryber ----------------------------------------------------------
MIN_AGE_SECONDS=300
LANGUAGE=pl
MAX_FILE_MB=20
# J1800 ma 4 wątki logiczne, ale system je też wykorzystuje.
# 4 działa, ale potrafi wypchnąć resztę — 3 to bezpieczny kompromis.
THREADS=3


# --- Web ------------------------------------------------------------------
# Port na hoście. W kontenerze zawsze 8074.
WEB_PORT=8074


# --- Ścieżki i strefa czasowa --------------------------------------------
# Katalog nagrań na hoście (względem katalogu z docker-compose.yml).
RECORDINGS_DIR=./recordings
TZ=Europe/Warsaw
